# =============================================================================
# TRADEFLOW PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.production (or .env) for production deployment.
# Replace ALL placeholder values with actual production values.

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=Unified Trading Engine
APP_VERSION=2.0.0
DEBUG=false
ENVIRONMENT=production

# =============================================================================
# SERVER SETTINGS
# =============================================================================
HOST=0.0.0.0
PORT=8000
RELOAD=false

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Generate secrets:
#   openssl rand -base64 64   (SECRET_KEY / JWT_SECRET_KEY)
#   openssl rand -hex 32      (CREDENTIAL_ENCRYPTION_KEY)
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CREDENTIAL_ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Use PostgreSQL for production
DATABASE_URL=postgresql://username:password@host:5432/tradeflow?sslmode=require
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_CONNECT_TIMEOUT_SECONDS=3
RUN_MIGRATIONS_ON_STARTUP=false

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://:password@host:6379/0
REDIS_CACHE_TTL=3600
REDIS_SESSION_TTL=86400

# =============================================================================
# NATS CONFIGURATION (Optional)
# =============================================================================
NATS_URL=

# =============================================================================
# API AND CORS CONFIGURATION
# =============================================================================
API_V1_STR=/api/v1
CORS_ORIGINS=["https://tradeflow.fluxeo.net", "https://www.tradeflow.fluxeo.net"]
RATE_LIMIT_PER_MINUTE=100

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/trading_engine.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# =============================================================================
# TRADELOCKER CONFIGURATION
# =============================================================================
# Brand API (legacy)
TRADELOCKER_API_KEY=
TRADELOCKER_API_URL=https://api.tradelocker.com
TRADELOCKER_WS_URL=wss://api.tradelocker.com/brand-api/socket.io/
TRADELOCKER_ENV=LIVE

# SDK credentials (preferred)
TRADELOCKER_USERNAME=
TRADELOCKER_PASSWORD=
TRADELOCKER_SERVER=
TRADELOCKER_ENVIRONMENT=https://demo.tradelocker.com

# =============================================================================
# TRADOVATE CONFIGURATION
# =============================================================================
TRADOVATE_API_URL=https://live.tradovate.com/api/v1
TRADOVATE_WS_URL=wss://live.tradovate.com/api/v1/websocket
TRADOVATE_USER_ID=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=TradingEngine
TRADOVATE_APP_VERSION=1.0.0
TRADOVATE_CID=TradingEngine
TRADOVATE_SEC=TradingEngine

# Tradovate OAuth
TRADOVATE_CLIENT_ID=
TRADOVATE_CLIENT_SECRET=
TRADOVATE_OAUTH_REDIRECT_URI=https://tradeflow.fluxeo.net/api/auth/tradovate/callback
TRADOVATE_OAUTH_ENVIRONMENT=live

# =============================================================================
# PROJECTX / TOPSTEP CONFIGURATION
# =============================================================================
PROJECTX_API_URL=https://api.topstepx.com
PROJECTX_WS_URL=wss://rtc.topstepx.com/hubs/user
PROJECTX_API_TOKEN=
PROJECTX_ENV=LIVE

# ProjectX SDK credentials (preferred)
PROJECT_X_USERNAME=
PROJECT_X_API_KEY=
PROJECT_X_ACCOUNT_NAME=

# ProjectX WebSocket hubs
PROJECTX_USER_HUB_URL=wss://rtc.topstepx.com/hubs/user
PROJECTX_MARKET_HUB_URL=wss://rtc.topstepx.com/hubs/market

# =============================================================================
# MT4 / MT5 CONFIGURATION (Legacy Manager API)
# =============================================================================
MT4_API_URL=http://localhost:8080/api
MT4_MANAGER_HOST=localhost
MT4_MANAGER_PORT=443
MT4_MANAGER_LOGIN=1
MT4_MANAGER_PASSWORD=

MT5_API_URL=http://localhost:8081/api
MT5_MANAGER_HOST=localhost
MT5_MANAGER_PORT=443
MT5_MANAGER_LOGIN=1
MT5_MANAGER_PASSWORD=

# MetaAPI SDK (preferred for MT4/MT5)
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
METAAPI_APPLICATION=tradeflow

# =============================================================================
# SIGNAL PROCESSING
# =============================================================================
SIGNAL_PROCESSING_ENABLED=true
SIGNAL_RETRY_ATTEMPTS=3
SIGNAL_RETRY_DELAY=5
SIGNAL_TIMEOUT=30

# =============================================================================
# RISK MANAGEMENT
# =============================================================================
MAX_POSITION_SIZE=100.0
MAX_DAILY_LOSS=1000.0
MAX_LEVERAGE=50
RISK_MANAGEMENT_ENABLED=true

# =============================================================================
# MONITORING
# =============================================================================
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=60

# =============================================================================
# CELERY
# =============================================================================
CELERY_BROKER_URL=redis://:password@host:6379/0
CELERY_RESULT_BACKEND=redis://:password@host:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json

# =============================================================================
# STRIPE (Optional)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Frontend URL (Stripe redirects)
FRONTEND_URL=https://tradeflow.fluxeo.net

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================
OWNER_ADMIN_EMAILS=

# =============================================================================
# OAUTH CONFIGURATION
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tradeflow.fluxeo.net/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# =============================================================================
# FRONTEND BUILD-TIME URLS (if building frontend from this env)
# =============================================================================
NEXT_PUBLIC_FRONTEND_URL=https://tradeflow.fluxeo.net
NEXT_PUBLIC_BACKEND_URL=https://api.tradeflow.fluxeo.net
NEXT_PUBLIC_WEBHOOK_BASE_URL=https://api.tradeflow.fluxeo.net
