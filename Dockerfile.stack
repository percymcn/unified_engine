FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy Python requirements first for better caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir --no-deps tradelocker>=0.56.0 && \
    pip install --no-cache-dir --no-deps metaapi-cloud-sdk>=29.0.0 && \
    pip install --no-cache-dir --no-deps metaapi-cloud-copyfactory-sdk && \
    pip install --no-cache-dir --no-deps metaapi-cloud-metastats-sdk && \
    pip install --no-cache-dir iso8601 aiohttp websockets psutil rapidfuzz PyJWT pandas joblib && \
    pip install --no-cache-dir "python-socketio[asyncio_client]==4.6.1" "python-engineio==3.14.2" && \
    pip install --no-cache-dir signalrcore lz4 msgpack-python websocket-client && \
    # Patch ProjectX SDK to add contractDisplayName field to Position model (line 387)
    sed -i '387 a\    contractDisplayName: str | None = None' /usr/local/lib/python3.12/site-packages/project_x_py/models.py

# Copy application code
COPY app/ ./app/
COPY alembic/ ./alembic/
COPY alembic.ini .

# Copy entrypoint script
COPY scripts/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Create necessary directories
RUN mkdir -p logs data

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
