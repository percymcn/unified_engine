# Production Environment
APP_ENV=production
DEBUG=false
LOG_LEVEL=WARNING

# Docker service names (secrets used for passwords)
DATABASE_URL=postgresql://trading_user:${DB_PASSWORD}@postgres:5432/trading_db
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222

# Security - ALL from Docker secrets
# SECRET_KEY - /run/secrets/secret_key
# JWT_SECRET_KEY - /run/secrets/jwt_secret
# CREDENTIAL_ENCRYPTION_KEY - /run/secrets/credential_encryption_key

# Strict CORS
CORS_ORIGINS=["https://yourdomain.com", "https://www.yourdomain.com"]

# Rate limiting (stricter in prod)
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=50

# UI
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
