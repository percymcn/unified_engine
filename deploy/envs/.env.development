# Development Environment
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# Local services
DATABASE_URL=postgresql://trading_user:trading_password@localhost:5432/trading_db
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222

# Security (weak for dev, never use in prod)
SECRET_KEY=dev-secret-key-not-for-production
JWT_SECRET_KEY=dev-jwt-secret-not-for-production
CREDENTIAL_ENCRYPTION_KEY=dev-encryption-key-32chars!!

# CORS for local dev
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# UI
NEXT_PUBLIC_API_URL=http://localhost:8000
