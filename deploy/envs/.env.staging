# Staging Environment
APP_ENV=staging
DEBUG=false
LOG_LEVEL=INFO

# Docker service names (secrets used for passwords)
DATABASE_URL=postgresql://trading_user:${DB_PASSWORD}@postgres:5432/trading_db
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222

# Security (use Docker secrets in production)
# SECRET_KEY - read from /run/secrets/secret_key
# JWT_SECRET_KEY - read from /run/secrets/jwt_secret
# CREDENTIAL_ENCRYPTION_KEY - read from /run/secrets/credential_encryption_key

# CORS for staging domain
CORS_ORIGINS=["https://staging.yourdomain.com"]

# UI
NEXT_PUBLIC_API_URL=https://staging.yourdomain.com/api
