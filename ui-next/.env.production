# Production Configuration - ALL PUBLIC URLs
# Same settings as local for consistent behavior

# Backend URL for server-side (BFF) requests
BACKEND_URL=https://api.tradeflow.fluxeo.net

# NEXT_PUBLIC_* vars are available on client side
NEXT_PUBLIC_BACKEND_URL=https://api.tradeflow.fluxeo.net
NEXT_PUBLIC_FRONTEND_URL=https://tradeflow.fluxeo.net
NEXT_PUBLIC_WEBHOOK_BASE_URL=https://api.tradeflow.fluxeo.net
NEXT_PUBLIC_WS_URL=wss://api.tradeflow.fluxeo.net/ws
NEXT_PUBLIC_API_URL=https://api.tradeflow.fluxeo.net

# Disable local banner
NEXT_PUBLIC_LOCAL_BANNER=0
