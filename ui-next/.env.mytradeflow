# Production Configuration for mytradeflow.app
# Copy this to .env.production when ready to switch domains

# Backend URL for server-side (BFF) requests
BACKEND_URL=https://api.mytradeflow.app

# NEXT_PUBLIC_* vars are available on client side
NEXT_PUBLIC_BACKEND_URL=https://api.mytradeflow.app
NEXT_PUBLIC_FRONTEND_URL=https://mytradeflow.app
NEXT_PUBLIC_WEBHOOK_BASE_URL=https://api.mytradeflow.app
NEXT_PUBLIC_WS_URL=wss://api.mytradeflow.app/ws
NEXT_PUBLIC_API_URL=https://api.mytradeflow.app

# Disable local banner
NEXT_PUBLIC_LOCAL_BANNER=0
