# =============================================================================
# TRADEFLOW PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.production for production deployment
# Replace ALL placeholder values with actual production values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Use PostgreSQL for production
DATABASE_URL=postgresql://username:password@host:port/database_name?sslmode=require

# Example: DATABASE_URL=postgresql://tradeflow_user:secure_password_123@aws-rds-endpoint.com:5432/tradeflow_prod?sslmode=require

# =============================================================================
# REDIS CONFIGURATION  
# =============================================================================
# Use Redis with authentication for production
REDIS_URL=redis://username:password@host:port

# Example: REDIS_URL=redis://tradeflow_user:secure_password_123@cache.tradeflow.com:6379/0

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Production frontend URL
NEXT_PUBLIC_FRONTEND_URL=https://tradeflow.fluxeo.net

# Backend API URL (accessible from frontend)
NEXT_PUBLIC_BACKEND_URL=https://api.tradeflow.fluxeo.net

# Webhook base URL for public webhook endpoints
NEXT_PUBLIC_WEBHOOK_BASE_URL=https://api.tradeflow.fluxeo.net

# =============================================================================
# GOOGLE OAUTH CONFIGURATION
# =============================================================================
# Google OAuth 2.0 credentials for production
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://tradeflow.fluxeo.net/api/auth/google/callback

# =============================================================================
# STRIPE CONFIGURATION (Optional - if using billing)
# =============================================================================
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT secret for token signing (generate: openssl rand -base64 64)
JWT_SECRET=your-super-secure-jwt-secret-min-64-chars

# Encryption service key (generate: openssl rand -hex 32)
ENCRYPTION_KEY=your-32-character-hex-encryption-key

# =============================================================================
# BROKER API CONFIGURATION
# =============================================================================
# TradeLocker configuration
TRADELOCKER_API_URL=https://api.tradelocker.com
TRADELOCKER_ENVIRONMENT=live

# Tradovate configuration  
TRADOVATE_API_URL=https://live.tradovate.com/v1

# ProjectX configuration
PROJECTX_API_URL=https://api.topstepx.com

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# Sentry for error tracking (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features for production
ENABLE_SIGNUPS=false
ENABLE_BILLING=true
ENABLE_RATE_LIMITING=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=error
LOG_FORMAT=json

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# Database connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# Redis connection pool
REDIS_POOL_SIZE=10

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=200